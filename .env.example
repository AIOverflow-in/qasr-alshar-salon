# ============================================================================
# Qasr Alshar Salon — Environment template. Copy to .env and fill in values.
# ============================================================================

# --- Database (Neon Postgres) ---
# Pooled connection (runtime). DIRECT_URL is the non-pooled host for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="+971500000000"
# Customer storefront (aftercare/e-commerce). Leave empty until the shop is live — links are hidden.
NEXT_PUBLIC_STOREFRONT_URL=""

# --- Bank-transfer payin (shown on invoices/checkout only when PAY_IBAN is set) ---
PAY_IBAN=""
PAY_ACCOUNT_NAME="Your Salon L.L.C"
PAY_BANK="Your Bank"
PAY_BIC=""

# --- Staff document storage (Vercel Blob; auto-set when a Blob store is created on the project) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- AI blog engine (provider-agnostic seam; see lib/ai) ---
# Text + image are independent, swappable slots. Default provider is "openai".
# To add Claude/GLM later: set the provider + its key; no code change to the blog.
TEXT_PROVIDER="openai"          # openai (anthropic/glm added later)
IMAGE_PROVIDER="openai"         # openai (glm added later; Claude has no image gen)
BLOG_TEXT_MODEL="gpt-4.1"       # generic model var (falls back to OPENAI_BLOG_MODEL)
BLOG_IMAGE_MODEL="gpt-image-1"  # generic model var (falls back to OPENAI_IMAGE_MODEL)
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."   # when TEXT_PROVIDER=anthropic
# GLM_API_KEY="..."                # when TEXT_PROVIDER/IMAGE_PROVIDER=glm
# Legacy vars still honoured for backward compatibility:
OPENAI_BLOG_MODEL="gpt-4.1"

# --- Storefront cache purge (ERP and public site are SEPARATE Vercel projects) ---
# Same value on BOTH projects. The ERP calls the public site after a product change so a price/stock
# edit shows on /shop immediately instead of waiting for the cache to expire.
REVALIDATE_SECRET="a-long-random-string"

# --- ERP "Ask" assistant ---
# Its own model on purpose: tuning the blog for quality must never multiply the assistant's bill.
# A small model is plenty for picking an intent or writing one SELECT (~$0.001/question, $0 on repeats).
ASSISTANT_TEXT_MODEL="gpt-4.1-mini"
# ASSISTANT_SQL_TIER="0"          # kill switch: falls back to the 8 built-in questions only

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
FROM_EMAIL="Your Salon <onboarding@resend.dev>"
# NOTE: owner/salon notification recipients (booking alerts, digest, reminders) are a
# FIXED list in code — see lib/notify-core.ts (NOTIFY_EMAILS) — not an env var.

# --- Admin dashboard ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$10$replace_with_bcrypt_hash"
AUTH_SECRET="generate_with_openssl_rand_hex_32"

# --- Cron protection (blog, daily summary, client follow-ups, payment reminders) ---
# Set this in the Vercel project too — Vercel attaches it as a Bearer token on cron calls.
CRON_SECRET="generate_a_random_string"
