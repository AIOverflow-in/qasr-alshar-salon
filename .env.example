# ============================================================================
# Qasr Alshar Salon — Environment template. Copy to .env and fill in values.
# ============================================================================

# --- Database (Neon Postgres) ---
# Pooled connection (runtime). DIRECT_URL is the non-pooled host for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="+971500000000"
# Customer storefront (aftercare/e-commerce). Leave empty until the shop is live — links are hidden.
NEXT_PUBLIC_STOREFRONT_URL=""

# --- Bank-transfer payin (shown on invoices/checkout only when PAY_IBAN is set) ---
PAY_IBAN=""
PAY_ACCOUNT_NAME="Your Salon L.L.C"
PAY_BANK="Your Bank"
PAY_BIC=""

# --- Staff document storage (Vercel Blob; auto-set when a Blob store is created on the project) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- OpenAI (auto blog + image generation) ---
OPENAI_API_KEY="sk-..."
OPENAI_BLOG_MODEL="gpt-4.1"

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
FROM_EMAIL="Your Salon <onboarding@resend.dev>"
# NOTE: owner/salon notification recipients (booking alerts, digest, reminders) are a
# FIXED list in code — see lib/notify-core.ts (NOTIFY_EMAILS) — not an env var.

# --- Admin dashboard ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$10$replace_with_bcrypt_hash"
AUTH_SECRET="generate_with_openssl_rand_hex_32"

# --- Cron protection (blog, daily summary, client follow-ups, payment reminders) ---
# Set this in the Vercel project too — Vercel attaches it as a Bearer token on cron calls.
CRON_SECRET="generate_a_random_string"
